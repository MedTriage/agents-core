# Copy to .env and fill in. .env is gitignored; never commit real values.

# LLM provider — every node's model call goes through OpenRouter.
OPENROUTER_API_KEY=

# Local Postgres (see README: the one-line `podman run`).
MEDTRIAGE_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg://medtriage:<same password>@127.0.0.1:5432/medtriage

# Email through Gmail: your address and a Google app password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Without these, emails queue in the database and nothing is sent.
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=MedTriage

# Where links in emails point.
APP_BASE_URL=http://localhost:3000

# Optional overrides.
# SNOMED_DB_PATH=data/snomed.db
# MCP_SERVER_DIR=vendor/medical-mcp
